@model AspMvcLibraryWebApp.Models.Publisher

<h4>@Model.Title Details</h4>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Logo)
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Logo))
            {
                <img src="~/images/@Model.Logo" height="80" />
            }
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-sm btn-primary">
       Edit
    </a>
    <a asp-action="Index"
       class="btn btn-sm btn-success">
        To Publishers Home
    </a>
</div>
